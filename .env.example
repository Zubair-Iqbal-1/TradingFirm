# TradingFirm — environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit it.

# ── Postgres ──
# DB_PASSWORD is required — docker-compose.yml fails fast (${DB_PASSWORD:?...}) without it.
DB_PASSWORD=
POSTGRES_DB=tradingfirm
POSTGRES_USER=tf_user

# ── Data provider (data-engine, risk-shield) ──
# yfinance in dev; swapped for a licensed feed before going public (see docs/plan-analyst-watcher.md §16).
DATA_PROVIDER=yfinance

# ── LLM provider (ai-agent) ──
# Plan D16: Anthropic claude-opus-5 is the default model everywhere; Gemini is a parked fallback (P3).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ── Web (Supabase auth — parked per D18, but the client reads these if set) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Context fetchers (Phase 2, data-engine) ──
FINNHUB_API_KEY=

# SEC EDGAR refuses undeclared clients (403). Format: "<app name> <contact email>", e.g. "MyApp me@example.com"
EDGAR_USER_AGENT=

# ── Macro data (Phase 3, risk-shield) ──
FRED_API_KEY=

# risk-shield's only write routes (Part 3.4c): PUT/DELETE
# /market/weekend/situation, sent as the X-TF-Token header. Any long random
# string. Leave empty to keep the routes disabled (503) — they never fall open.
WEEKEND_WRITE_TOKEN=

# ── Watcher price feed (Phase 6, signal-engine) ──
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Notifier (Phase 5) ──
TELEGRAM_BOT_TOKEN=

# Alpha Vantage (Part 2.3) — fallback source for past earnings report dates
# when yfinance has none. Free tier: 5 requests/minute, 25/day.
# Get a key at https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
